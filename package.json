{
  "name": "finahead",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "FinAhead - See your balance before payday.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "npm run bench:synthetic && npm run bench:moneydata",
    "bench:synthetic": "vite-node benchmark/synthetic/main.ts",
    "bench:moneydata": "vite-node benchmark/moneydata/run.ts && vite-node benchmark/moneydata/run-reviewed.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
